[Unit]
Description=Camera Car OCR - API Server (uvicorn)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/camera_car_ocr/backend
Environment="PATH=/root/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=/root/.local/bin/uv run uvicorn app.api_server:app --host 0.0.0.0 --port 8000 --reload
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
